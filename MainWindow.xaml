<Window x:Class="BankManagementWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank System v2.0 — Система Управління Рахунками" 
        Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        x:Name="RootWindow"
        Background="#F4F6F9">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель: Заголовок + Перемикач теми -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="🏦 Bank Management System" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock x:Name="TotalCapitalText" Text=" | Капітал банку: 0.00 UAH" FontSize="15" Foreground="#27AE60" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,2,0,0"/>
            </StackPanel>

            <CheckBox x:Name="DarkThemeCheckBox" Content="🌙 Темна тема" HorizontalAlignment="Right" VerticalAlignment="Center" 
                      FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"
                      Checked="ThemeCheckBox_Changed" Unchecked="ThemeCheckBox_Changed"/>
        </Grid>

        <!-- Основний робочий простір -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ліва панель: Пошук, Список, Операції та Новий рахунок -->
            <Border x:Name="LeftCardBorder" Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="AccountsLabel" Text="Банківські Рахунки" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                        <!-- 1. Пошук рахунків (LINQ) -->
                        <TextBlock x:Name="SearchLabel" Text="🔍 Пошук (Ім'я або номер):" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                        <TextBox x:Name="SearchTextBox" Height="28" Padding="4" VerticalContentAlignment="Center" 
                                 TextChanged="SearchTextBox_TextChanged" Margin="0,0,0,8"/>

                        <!-- Список рахунків -->
                        <ListBox x:Name="AccountsListBox" Height="125" DisplayMemberPath="OwnerName" 
                                 SelectionChanged="AccountsListBox_SelectionChanged" Margin="0,0,0,12"/>

                        <Separator Margin="0,0,0,12"/>

                        <!-- Операції з обраним рахунком -->
                        <TextBlock x:Name="OperationsLabel" Text="Операції з рахунком" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>

                        <TextBlock x:Name="AmountLabel" Text="Сума (UAH):" Margin="0,2,0,2"/>
                        <TextBox x:Name="AmountTextBox" Height="28" Padding="4" VerticalContentAlignment="Center" 
                                 TextChanged="AmountTextBox_TextChanged"/>
                        <TextBlock x:Name="ValidationHintText" Text="Введіть додатне число для активації кнопок" 
                                   FontSize="11" Foreground="#E67E22" Margin="0,2,0,6"/>

                        <TextBlock x:Name="DescLabel" Text="Опис / Рахунок отримувача (для переказу):" Margin="0,2,0,2"/>
                        <TextBox x:Name="TargetOrDescriptionTextBox" Height="28" Padding="4" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button x:Name="DepositButton" Content="Поповнити" Click="DepositButton_Click" IsEnabled="False"
                                    Height="32" Background="#2ECC71" Foreground="White" FontWeight="Bold" Margin="0,0,4,0"/>
                            <Button x:Name="WithdrawButton" Content="Зняти" Click="WithdrawButton_Click" IsEnabled="False"
                                    Height="32" Background="#E74C3C" Foreground="White" FontWeight="Bold" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <Button x:Name="TransferButton" Content="Переказати кошти" Click="TransferButton_Click" IsEnabled="False"
                                Height="32" Background="#3498DB" Foreground="White" FontWeight="Bold" Margin="0,0,0,14"/>

                        <Separator Margin="0,0,0,12"/>

                        <!-- 3. Відкриття нового рахунку -->
                        <TextBlock x:Name="NewAccountLabel" Text="➕ Відкрити новий рахунок" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        
                        <TextBlock x:Name="NewOwnerLabel" Text="ПІБ власника:" FontSize="12" Margin="0,2,0,2"/>
                        <TextBox x:Name="NewOwnerTextBox" Height="26" Padding="3" VerticalContentAlignment="Center" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock x:Name="NewNumberLabel" Text="Номер (UA...):" FontSize="12"/>
                                <TextBox x:Name="NewAccNumberTextBox" Height="26" Padding="3" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock x:Name="NewBalanceLabel" Text="Стартовий баланс:" FontSize="12"/>
                                <TextBox x:Name="NewInitialBalanceTextBox" Height="26" Padding="3" VerticalContentAlignment="Center" Text="500"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="CreateAccountButton" Content="Створити рахунок" Click="CreateAccountButton_Click"
                                Height="32" Background="#8E44AD" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Права панель: Деталі, кольорова історія та Експорт виписки -->
            <Border x:Name="RightCardBorder" Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок рахунку та кнопка експорту -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock x:Name="AccountDetailsTitleText" Text="Оберіть рахунок зі списку" FontSize="19" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock x:Name="BalanceText" Text="Баланс: 0.00 UAH" FontSize="17" Foreground="#27AE60" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 4. Кнопка експорту виписки -->
                        <Button x:Name="ExportButton" Content="📄 Завантажити виписку (.csv)" Click="ExportButton_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,6"
                                Background="#34495E" Foreground="White" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock x:Name="HistoryLabel" Grid.Row="1" Text="Історія операцій (зелений — зарахування, червоний — списання):" 
                               FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,8"/>

                    <!-- 5. Список транзакцій з кольоровим підсвічуванням -->
                    <ListBox x:Name="TransactionsListBox" Grid.Row="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayValue}" Foreground="{Binding DisplayColor}" 
                                           FontWeight="SemiBold" Padding="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>